[Unit]
Description=THINK//CODE AI Content Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/think-code-mediabot
ExecStart=/opt/think-code-mediabot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
