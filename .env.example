# Copy to .env and fill in
# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@think_code
TELEGRAM_ADMIN_IDS=123456789,987654321
# Admin review group: bot posts previews here, founders approve there.
# Create a private group, add the bot as admin, send /start, copy chat id via @userinfobot.
# Looks like -1001234567890
TELEGRAM_REVIEW_GROUP_ID=-1001234567890

# --- Gemini ---
# Cost-efficient lite baseline (founder choice). Swap to gemini-3.8-flash /
# gemini-3.6-flash in .env anytime — model ID is env-configurable, no code change.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VALIDATOR_MODEL=gemini-3.5-flash-lite

# --- Firebase (Firestore as backend) ---
# Project: think-code-mediabot (created 2026-09-16)
# Option A (local dev): path to service-account JSON
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Option B: inline JSON string (for Railway/Render/Fly)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

FIREBASE_PROJECT_ID=think-code-mediabot

# --- Fly.io ---
FLY_APP_NAME=think-code-mediabot

# --- Scheduler ---
# Preferred publish time HH:MM (UTC+5 Tashkent default for THINK//CODE)
DEFAULT_PUBLISH_TIME=12:00
TIMEZONE=Asia/Tashkent
